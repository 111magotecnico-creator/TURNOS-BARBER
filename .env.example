# ═════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — BARBER STUDIO
# Copiar a .env y completar los valores.
# En Vercel: configurar en Settings → Environment Variables.
# ═════════════════════════════════════════════════════════

# ── Base de datos (PostgreSQL requerido para producción) ──
# Neon (gratuito): https://neon.tech → copiar connection string
# Formato: postgresql://usuario:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# ── Autenticación ──
# JWT_SECRET: mínimo 32 caracteres, string aleatorio largo
# Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-esto-por-un-string-largo-seguro"
ADMIN_EMAIL="admin@barberstudio.com"
ADMIN_PASSWORD="cambiar-estos-datos-en-produccion"

# ── URL de la aplicación ──
# En Vercel: https://tu-barberia.vercel.app
NEXT_PUBLIC_APP_URL="https://tu-barberia.vercel.app"

# ── Cron / Webhooks ──
# Generar uno propio para proteger endpoints de cron
CRON_SECRET="cambiar-esto-para-cron-seguro"

# ── MercadoPago (opcional) ──
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# ── WhatsApp Business (opcional) ──
# WHATSAPP_TOKEN="..."
# WHATSAPP_PHONE_ID="..."
